from collections import deque

def puzzle(start, goal):
    q = deque([(start, [])])
    visited = set()

    while q:
        state, path = q.popleft()

        if state == goal:
            return path + [state]

        if state in visited:
            continue
        visited.add(state)

        i = state.index(0)
        r, c = divmod(i, 3)

        for dr, dc in [(1,0), (-1,0), (0,1), (0,-1)]:
            nr, nc = r + dr, c + dc

            if 0 <= nr < 3 and 0 <= nc < 3:
                j = nr * 3 + nc
                new = list(state)
                new[i], new[j] = new[j], new[i]
                q.append((tuple(new), path + [state]))

start = (1, 2, 3, 4, 0, 6, 7, 5, 8)
goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)

answer = puzzle(start, goal)

for state in answer:
    print(state[:3])
    print(state[3:6])
    print(state[6:])
    print()
