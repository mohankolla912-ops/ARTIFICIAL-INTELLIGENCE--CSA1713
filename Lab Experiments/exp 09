from itertools import permutations

distance = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

n = len(distance)
min_cost = float('inf')

for p in permutations(range(1, n)):
    route = (0,) + p + (0,)
    cost = 0

    for i in range(n):
        cost += distance[route[i]][route[i+1]]

    if cost < min_cost:
        min_cost = cost
        best_route = route

print("Shortest Route:", best_route)
print("Minimum Distance:", min_cost)
